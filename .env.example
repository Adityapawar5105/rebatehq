# Supabase Auth (publishable key only; never put a service-role key here)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
APP_BASE_URL=http://localhost:3000

# Server-only PostgreSQL login that can SET LOCAL ROLE rebatehq_app; it must be NOSUPERUSER/NOBYPASSRLS.
# Do not use the Supabase postgres/service-role credentials here.
APP_DATABASE_URL=postgresql://rebatehq_app_login:REPLACE_ME@YOUR_POOLER_HOST:6543/postgres?sslmode=require

# Seed/migration admin URL is used only by local CLI scripts, never by web routes.
SEED_DATABASE_URL=postgresql://postgres:REPLACE_ME@YOUR_DB_HOST:5432/postgres?sslmode=require
DEMO_OWNER_USER_ID=00000000-0000-0000-0000-000000000000

# Optional secrets for the manual restore-drill workflow's hosted mode only.
# Source must be a disposable seeded project; target must be a fresh disposable project.
RESTORE_TEST_SOURCE_DATABASE_URL=
RESTORE_TEST_TARGET_DATABASE_URL=

# Invite email (Resend); required for production invite delivery.
RESEND_API_KEY=re_REPLACE_ME
EMAIL_FROM=RebateHQ <invites@example.com>

# Distributed rate limiting; production auth/import/invite/export routes fail closed without these.
UPSTASH_REDIS_REST_URL=https://YOUR_UPSTASH_ENDPOINT.upstash.io
UPSTASH_REDIS_REST_TOKEN=REPLACE_ME

# 32-byte base64 key for AES-256-GCM connector secret encryption.
CONNECTOR_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# Development only. Impersonation requires both variables and NODE_ENV=development.
DEV_IMPERSONATION_ENABLED=false
DEV_IMPERSONATION_SECRET=REPLACE_WITH_RANDOM_32_BYTE_SECRET
CONNECTOR_ENCRYPTION_KEY_VERSION=1

# Chunk 3C, server-only. Sheets stages reviews; recurring execution needs ingest:due.
MD_SHEETS_INGESTION=false
MD_EMAIL_DROP_STUB=false
MD_SFTP_DROP_STUB=false
# Trusted scheduled-runner identity; active owner/manager membership is required.
TENANT_ID=
ACTOR_ID=

# Chunk 4B: default-off synthetic browser harness; leave unset in deployment.
VAULT_LAB_ENABLED=
# Browser-test base URL and real local Supabase mail URL (CI derives these).
VAULT_TEST_URL=
VAULT_MAIL_URL=


# 5B: server-only audit HMAC (64 hex chars), server-only Ed25519 PKCS8 base64,
# and public SPKI base64. Configure in the operator secret manager, never commit values.
ACTOR_SIGNING_SECRET=
LICENCE_SIGNING_KEY=
NEXT_PUBLIC_LICENCE_VERIFY_KEY=

# Ciphertext relay: enable only after operator review; disabled by default.
RELAY_ENABLED=false
# 8D benchmarks: off unless true. The pseudonym key is 32 random bytes in hex, kept only in the server environment
# (never in the database); rotating it unlinks earlier contributions from their workspaces.
BENCHMARKS_ENABLED=false
BENCH_PSEUDONYM_KEY=
